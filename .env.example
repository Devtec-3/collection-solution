# Copy this file to .env for local work, and set the same keys in Render.
# Never commit the real .env — it is already in .gitignore.

PORT=3000
NODE_ENV=production

# --- Database ---
# Neon or Render Postgres connection string. Empty falls back to a local
# SQLite file, which is for development only.
DATABASE_URL=

# --- First sign-in (created once, on the first boot) ---
# Use the owner's own email. If OWNER_PASSWORD is left empty the server
# generates a strong password and prints it once in the boot log.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Added when each piece is connected (see LIVE-SETUP.md) ---
# ANTHROPIC_API_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# PAYSTACK_SECRET_KEY=
