# Copy this file to .env for local work, and set the same keys in Render.
# Never commit the real .env — it is already in .gitignore.

PORT=3000
NODE_ENV=production

# --- Database ---
# Neon (or any) Postgres connection string. Empty falls back to a local SQLite
# file, which is for development only.
DATABASE_URL=

# --- First sign-in (created once, on the first boot of an empty database) ---
# Use the owner's own email. If OWNER_PASSWORD is left empty the server
# generates a strong password and prints it once in the boot log.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Payments: transfer only, confirmed by staff (never by the AI) ---
PAYMENT_BANK=Opay
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=

# --- AI assistant (one of these; Gemini free tier is recommended) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://console.anthropic.com  (paid, per token)
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Product photo storage (S3-compatible: R2 / Supabase / Neon storage) ---
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets
